# 复制为 .env 后填写：cp .env.example .env
# 所有配置都在这里，改完 docker compose up -d 生效

# 时区
TZ=Asia/Shanghai

# DeepSeek API key（填这里，或留空后启动在网页 设置→Models 填）
DEEPSEEK_API_KEY=

# 额外信任的域名（空格分隔），如 Tailscale 域名；仅局域网 IP 访问可留空
# 示例：DSH_TRUSTED_HOSTS=tower.tailf8062c.ts.net
DSH_TRUSTED_HOSTS=

# npm 源：国内网络构建失败时改为 https://registry.npmmirror.com
NPM_REGISTRY=https://registry.npmjs.org
